{
  "name": "mi-app-react",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "prepare:dist": "node -e \"require('fs').mkdirSync('public/dist', { recursive: true })\"",
    "dev-old": "vite",
    "dev": "concurrently --names \"REACT,EXPRESS\" --prefix-colors \"cyan,green\" \"vite build & npm run watch\" \"npm run dev-server\"",
    "build": "npm run prepare:dist && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "watch2": "chokidar \"src/**/*\" -c \"vite build\"",
    "watch": "chokidar \"src/**/*\" \"views/**/*\" --debounce 500 -c \"vite build\"",
    "dev-server": "nodemon server.js",
    "db:new": "npx dbmate -d \"db/migrations\" -e \"DB\" new ",
    "db:up": "npx dbmate -d \"db/migrations\" -e \"DB\" up",
    "db:rollback": "npx dbmate -d \"db/migrations\" -e \"DB\" rollback",
    "db:dump": "npx dbmate -d \"db/migrations\" -s \"db/schema.sql\" -e \"DB\" dump",
    "db:dumpdata": "node -e \"const { execSync } = require('child_process'); require('dotenv').config(); execSync('pg_dump --dbname=' + process.env.DB + ' --file=db/dump_complete.sql --clean --if-exists --inserts', { stdio: 'inherit' });\""
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "axios": "^1.19.0",
    "bootstrap": "^5.3.8",
    "connect-flash": "^0.1.1",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.9",
    "ejs-mate": "^4.0.0",
    "express": "^5.2.1",
    "express-session": "^1.18.2",
    "morgan": "^1.10.1",
    "pg": "^8.13.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.2",
    "sequelize": "^6.37.8",
    "session-file-store": "^1.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vercel/node": "^3.0.0",
    "@vitejs/plugin-react": "^4.2.1",
    "chokidar-cli": "^3.0.0",
    "concurrently": "^10.0.4",
    "dbmate": "^2.26.0",
    "eslint": "^9.9.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.12",
    "globals": "^15.9.0",
    "nodemon": "^3.1.14",
    "react-toastify": "^11.1.0",
    "vite": "^5.2.0"
  }
}
