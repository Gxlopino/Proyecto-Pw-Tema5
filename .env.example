# Copia este archivo como .env (no se sube al repositorio)
PORT=3000
NODE_ENV=development
SESSION_SECRET=cambia-esto

# Entrega 1: los services usan db/seed/seed.json. En la Entrega 2 cambia a false.
VITE_USE_MOCK=true

# Base de datos (Entrega 2 · Supabase)
DB_HOST=
DB_PORT=5432
DB_NAME=postgres
DB_USER=
DB_PASS=
DB_SSL=true
DB=postgres://usuario:clave@host:5432/postgres
