<!-- views/partials/_flash_message.ejs · mensajes de req.flash('success' | 'error') -->
<% if (successMessage && successMessage.length) { %>
  <div class="container-xl pt-3">
    <% successMessage.forEach(function (msg) { %>
      <div class="alert alert-success small mb-2" role="alert"><%= msg %></div>
    <% }) %>
  </div>
<% } %>
<% if (errorMessage && errorMessage.length) { %>
  <div class="container-xl pt-3">
    <% errorMessage.forEach(function (msg) { %>
      <div class="alert alert-danger small mb-2" role="alert"><%= msg %></div>
    <% }) %>
  </div>
<% } %>
