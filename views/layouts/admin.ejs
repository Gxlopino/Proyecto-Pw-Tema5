<!-- views/layouts/admin.ejs -->
<!-- Mini-app React de un rol. Recibe "rol" (usuario | tecnico | supervisor) desde el controller. -->
<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <link rel="icon" type="image/x-icon" href="/favicon.ico">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <!-- CSS compartido (Bootstrap + sistema de diseño) -->
  <link rel="stylesheet" href="/dist/css/app.css">
  <!-- CSS exclusivo del rol (src/pages/<rol>/<rol>.css) -->
  <link rel="stylesheet" href="/dist/css/<%= rol %>.css">

  <title><%= title %></title>
</head>
<body>

  <%- body %>

  <!-- JavaScript de la mini-app del rol -->
  <script type="module" src="/dist/js/<%= rol %>.js"></script>
</body>
</html>
