<!-- views/partials/_navbar.ejs · cabecera pública (visitante) -->
<nav class="navbar navbar-expand-lg public-header py-2">
  <div class="container-xl">
    <a href="/" class="brand d-flex align-items-center gap-2">
      <span class="brand-mark"></span> Mesa de Ayuda <span class="text-muted fw-normal d-none d-sm-inline">· Campus Ulima</span>
    </a>
    <% if (typeof currentPage !== 'undefined' && currentPage === 'home') { %>
      <!-- Easter egg: Claude bailando (solo en la página principal) -->
      <img src="/assets/img/claude-bailando.svg" alt="Claude bailando" title="¡Gracias por pasar!" width="34" height="31" class="ms-2 me-auto me-lg-0">
    <% } %>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#publicNav" aria-controls="publicNav" aria-expanded="false" aria-label="Abrir menú">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="publicNav">
      <ul class="navbar-nav me-auto ms-lg-4">
        <li class="nav-item"><a href="/" class="nav-link <%= typeof currentPage !== 'undefined' && currentPage === 'home' ? 'active' : '' %>">Inicio</a></li>
        <li class="nav-item"><a href="/#como-reportar" class="nav-link">Cómo reportar</a></li>
        <li class="nav-item"><a href="/#categorias" class="nav-link">Categorías de servicio</a></li>
        <li class="nav-item"><a href="/#tiempos" class="nav-link">Tiempos de atención</a></li>
      </ul>
      <div class="d-flex gap-2 py-2 py-lg-0">
        <% if (isAuthenticated) { %>
          <a href="<%= rutaInicio %>" class="btn btn-primary btn-sm">Ir a mi panel</a>
          <a href="/logout" class="btn btn-outline-primary btn-sm">Cerrar sesión</a>
        <% } else { %>
          <a href="/login" class="btn btn-outline-primary btn-sm">Iniciar sesión</a>
          <a href="/registro" class="btn btn-primary btn-sm">Registrarme</a>
        <% } %>
      </div>
    </div>
  </div>
</nav>
