<!-- views/404.ejs -->
<% layout("layouts/access") %>

<div class="card p-4 p-lg-5 mx-auto" style="max-width: 720px;">
  <div class="big-number mb-2">404</div>
  <h1 class="mb-2">No encontramos esta página</h1>
  <p class="text-muted">El enlace puede haber cambiado. Si buscabas un ticket, ingresa su código en el buscador de la cabecera de tu panel.</p>
  <div class="d-flex flex-wrap gap-2">
    <a href="/" class="btn btn-primary"><i class="fa-solid fa-house me-2"></i>Ir al inicio</a>
    <a href="<%= rutaInicio %>" class="btn btn-outline-primary"><%= isAuthenticated ? 'Ir a mi panel' : 'Iniciar sesión' %></a>
  </div>
</div>
