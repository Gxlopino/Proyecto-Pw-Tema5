@startuml db_model
' Configuración visual
skinparam class {
    BackgroundColor White
    ArrowColor #2C3E50
    BorderColor #2C3E50
}
skinparam roundcorner 5
skinparam shadowing false

' ==========================================
' ENTIDADES FUERTES (Independientes)
' ==========================================

entity "usuario" as usuario <<Fuerte>> {
  * id : uuid [PK]
  --
  nombres : varchar
  apellidos : varchar
  email : varchar [UQ]
  passwordHash : varchar
  telefono : varchar
  unidad : varchar
  vinculo : varchar
  rol : enum (usuario|tecnico|supervisor)
  estado : enum (activo|inactivo|bloqueado)
  motivoBloqueo : varchar
  ambienteHabitualId : uuid [FK]
  creadoEn : timestamp
  ultimoAcceso : timestamp
}

entity "categoria" as categoria <<Fuerte>> {
  * id : uuid [PK]
  --
  nombre : varchar
  parentId : uuid [FK] <<Null=Categoría, Value=Subcategoría>>
  prioridadDefecto : enum (critica|alta|media|baja)
  tiempoEsperadoHoras : int
  descripcion : varchar(240)
  activa : boolean
}

entity "ambiente" as ambiente <<Fuerte>> {
  * id : uuid [PK]
  --
  codigo : varchar (ej. A-201)
  tipo : varchar
  pabellon : varchar
  piso : int
  sede : varchar
  capacidad : int
}

' ==========================================
' ENTIDADES ASOCIATIVAS (Relacionan M:N)
' ==========================================

entity "tecnico_categoria" as tecnico_categoria <<Asociativa>> {
  * tecnicoId : uuid [PK, FK]
  * categoriaId : uuid [PK, FK]
  --
  ' Representa las especialidades del técnico
}

' ==========================================
' ENTIDADES DÉBILES / DEPENDIENTES
' ==========================================

entity "ticket" as ticket <<Débil>> {
  * id : uuid [PK]
  --
  codigo : varchar [UQ] (ej. TCK-2026-00147)
  asunto : varchar
  descripcion : varchar(600)
  categoriaId : uuid [FK]
  subcategoriaId : uuid [FK]
  ambienteId : uuid [FK]
  solicitanteId : uuid [FK]
  tecnicoId : uuid [FK, Nullable]
  prioridad : enum
  prioridadSugerida : enum
  estado : varchar
  creadoEn : timestamp
  venceEn : timestamp
  cerradoEn : timestamp
  solucion : text
  motivoEspera : text
  fechaRetorno : timestamp
}

entity "bitacora_entrada" as bitacora_entrada <<Débil>> {
  * id : uuid [PK]
  --
  ticketId : uuid [FK]
  autorId : uuid [FK]
  tipo : enum (publico|interno)
  texto : text
  creadoEn : timestamp
}

entity "historial_estado" as historial_estado <<Débil>> {
  * id : uuid [PK]
  --
  ticketId : uuid [FK]
  estadoAnterior : varchar
  estadoNuevo : varchar
  autorId : uuid [FK]
  motivo : text
  creadoEn : timestamp
}

entity "asignacion" as asignacion <<Débil>> {
  * id : uuid [PK]
  --
  ticketId : uuid [FK]
  tecnicoId : uuid [FK]
  asignadoPorId : uuid [FK]
  motivo : varchar
  nota : text
  creadoEn : timestamp
}

entity "cambio_prioridad" as cambio_prioridad <<Débil>> {
  * id : uuid [PK]
  --
  ticketId : uuid [FK]
  anterior : enum
  nueva : enum
  motivo : varchar
  autorId : uuid [FK]
  creadoEn : timestamp
}

entity "encuesta" as encuesta <<Débil>> {
  * id : uuid [PK]
  --
  ticketId : uuid [FK, UQ]
  usuarioId : uuid [FK]
  puntaje : int
  rapidez : int
  trato : int
  solucion : int
  comentario : text
  creadoEn : timestamp
  editableHasta : timestamp
}

' ==========================================
' RELACIONES
' ==========================================

' Relaciones de Usuario
usuario }o--|| ambiente : "ambienteHabitualId"

' Relación recursiva de Categoría (Subcategoría)
categoria }o--o| categoria : "parentId"

' Relaciones Asociativas
usuario "1" -- "0..*" tecnico_categoria : "tecnicoId"
categoria "1" -- "0..*" tecnico_categoria : "categoriaId"

' Relaciones del Ticket (Depende de Múltiples Fuertes)
ticket }o--|| categoria : "categoriaId"
ticket }o--|| categoria : "subcategoriaId"
ticket }o--|| ambiente : "ambienteId"
ticket }o--|| usuario : "solicitanteId"
ticket }o--o| usuario : "tecnicoId (Asignado)"

' Relaciones de las Entidades Débiles del Ticket
bitacora_entrada }|--|| ticket : "ticketId"
bitacora_entrada }o--|| usuario : "autorId"

historial_estado }|--|| ticket : "ticketId"
historial_estado }o--|| usuario : "autorId"

asignacion }|--|| ticket : "ticketId"
asignacion }o--|| usuario : "tecnicoId"
asignacion }o--|| usuario : "asignadoPorId"

cambio_prioridad }|--|| ticket : "ticketId"
cambio_prioridad }o--|| usuario : "autorId"

' Relación 1:1 entre Ticket y Encuesta
encuesta ||--|| ticket : "ticketId (Único)"
encuesta }o--|| usuario : "usuarioId"

@enduml